<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_moments">

    <fragment
        android:id="@+id/navigation_moments"
        android:name="com.sinoll.synapse_app.ui.content.MomentFragment"
        android:label="@string/title_moments"
        tools:layout="@layout/fragment_content_list" />

    <fragment
        android:id="@+id/navigation_gallery"
        android:name="com.sinoll.synapse_app.ui.content.GalleryFragment"
        android:label="@string/title_gallery"
        tools:layout="@layout/fragment_content_list" />

    <fragment
        android:id="@+id/navigation_video"
        android:name="com.sinoll.synapse_app.ui.dashboard.VideoFeedFragment"
        android:label="@string/title_video"
        tools:layout="@layout/fragment_video_feed" />

    <fragment
        android:id="@+id/navigation_blog"
        android:name="com.sinoll.synapse_app.ui.home.HomeFragment"
        android:label="@string/title_blog"
        tools:layout="@layout/fragment_content_list" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.sinoll.synapse_app.ui.notifications.NotificationsFragment"
        android:label="@string/title_profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profile_to_my_content"
            app:destination="@id/my_content" />
        <action
            android:id="@+id/action_profile_to_content_detail"
            app:destination="@id/content_detail" />
    </fragment>

    <action
        android:id="@+id/action_global_content_detail"
        app:destination="@id/content_detail" />

    <action
        android:id="@+id/action_global_create_content"
        app:destination="@id/create_content" />

    <action
        android:id="@+id/action_global_create_video"
        app:destination="@id/create_video" />

    <action
        android:id="@+id/action_global_search"
        app:destination="@id/search" />

    <fragment
        android:id="@+id/create_video"
        android:name="com.sinoll.synapse_app.ui.content.CreateVideoFragment"
        android:label="@string/video_publish_title"
        tools:layout="@layout/fragment_create_video" />

    <fragment
        android:id="@+id/create_content"
        android:name="com.sinoll.synapse_app.ui.content.CreateContentFragment"
        android:label="@string/content_create_description"
        tools:layout="@layout/fragment_create_content">
        <argument
            android:name="content_type"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/my_content"
        android:name="com.sinoll.synapse_app.ui.profile.MyContentFragment"
        android:label="@string/profile_my_content_title"
        tools:layout="@layout/fragment_content_list">
        <argument
            android:name="user_id"
            app:argType="integer" />
        <action
            android:id="@+id/action_my_content_to_content_detail"
            app:destination="@id/content_detail" />
    </fragment>

    <fragment
        android:id="@+id/content_detail"
        android:name="com.sinoll.synapse_app.ui.content.ContentDetailFragment"
        android:label="@string/content_detail_title"
        tools:layout="@layout/fragment_content_detail">
        <argument
            android:name="content_type"
            app:argType="string" />
        <argument
            android:name="content_id"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/search"
        android:name="com.sinoll.synapse_app.ui.content.ContentSearchFragment"
        android:label="@string/content_search_title"
        tools:layout="@layout/fragment_content_search" />
</navigation>